# ===== RPC target =====
# RPC ที่รันบน host เดียวกัน -> host.docker.internal
# RPC เครื่องอื่น -> ใส่ IP ตรงๆ เช่น 10.0.0.15
RPC_HOST=host.docker.internal
RPC_PORT=28545
RPC_SCHEME=http
# ถ้าตั้ง RPC_URL จะ override HOST/PORT/SCHEME ทั้งหมด (เช่น https://rpc.example.com)
#RPC_URL=

# ===== Check behaviour =====
# ความถี่ในการเช็ค (รับ 15, 15s, 1m)
CHECK_INTERVAL=1m
# block ไม่ขยับเกินเวลานี้ = stalled -> 503
# (LUKSO/ETH block ~12s, ตั้ง 120s = ประมาณ 10 block)
STALL_THRESHOLD=120s
RPC_TIMEOUT=5s

# ===== Expose =====
HOST_PORT=8080
